# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.
FIREBASE_SERVICE_ACCOUNT_B64=   # base64 of the service-account JSON (local dev can use .secrets/firebase-admin.json instead)
STRIPE_SECRET_KEY=              # sk_test_... (sk_live_... at launch)
STRIPE_WEBHOOK_SECRET=          # whsec_... from the Stripe webhook endpoint /api/stripe/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_PASSWORD=                 # /admin basic auth (any username)
IP_SALT=                        # random string for hashing visitor IPs
MAX_ORDERS=20
MAX_ORDERS_PER_DAY=4
SITE_URL=                       # optional; defaults to the Vercel production URL
NEXT_PUBLIC_GA4_MEASUREMENT_ID= # G-XXXX (before launch)
GA4_MEASUREMENT_ID=             # same G-XXXX, for server-side agent events
GA4_API_SECRET=                 # GA4 Measurement Protocol secret
SUPPORT_EMAIL=
